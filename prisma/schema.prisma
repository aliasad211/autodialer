generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum UserRole {
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  INTERESTED
  FOLLOW_UP
  CONVERTED
  NOT_INTERESTED
}

enum CallStatus {
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  REJECTED
}

enum CallOutcome {
  INTERESTED
  FOLLOW_UP
  CONVERTED
  NOT_INTERESTED
  NO_RESPONSE
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/**
 * |--------------------------------------------------------------------------
 * | USER
 * |--------------------------------------------------------------------------
 */

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  role   UserRole   @default(AGENT)
  status UserStatus @default(ACTIVE)

  regionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  assignedLeads Lead[]     @relation("AgentLeads")
  callLogs      CallLog[]
  followUps     FollowUp[]

  createdLeads Lead[] @relation("CreatedLeads")

  @@index([regionId])
  @@index([role])
  @@index([status])
}

/**
 * |--------------------------------------------------------------------------
 * | REGION
 * |--------------------------------------------------------------------------
 */

model Region {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  leads Lead[]

  @@index([name])
}

/**
 * |--------------------------------------------------------------------------
 * | LEAD
 * |--------------------------------------------------------------------------
 */

model Lead {
  id String @id @default(cuid())

  customerName String
  phone        String

  city    String?
  country String? @default("Pakistan")

  vehicleInterest String?

  status LeadStatus @default(NEW)

  notes String?

  regionId    String
  agentId     String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  agent User? @relation("AgentLeads", fields: [agentId], references: [id], onDelete: SetNull)

  createdBy User? @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)

  callLogs  CallLog[]
  followUps FollowUp[]

  @@index([phone])
  @@index([status])
  @@index([regionId])
  @@index([agentId])
  @@index([createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | CALL LOG
 * |--------------------------------------------------------------------------
 */

model CallLog {
  id String @id @default(cuid())

  leadId  String
  agentId String

  startedAt DateTime
  endedAt   DateTime?

  duration Int?

  callStatus CallStatus
  outcome    CallOutcome?

  notes String?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agent User @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([agentId])
  @@index([startedAt])
  @@index([callStatus])
}

/**
 * |--------------------------------------------------------------------------
 * | FOLLOW UP
 * |--------------------------------------------------------------------------
 */

model FollowUp {
  id String @id @default(cuid())

  leadId  String
  agentId String

  scheduledAt DateTime

  status FollowUpStatus @default(PENDING)

  notes String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agent User @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([agentId])
  @@index([scheduledAt])
  @@index([status])
}
